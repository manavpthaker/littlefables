{
  "name": "little-fables",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "prebuild": "tsx scripts/build-precache-manifest.ts",
    "build": "next build",
    "postbuild": "tsx scripts/build-precache-manifest.ts --restore",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up",
    "db:types": "supabase gen types typescript --linked --schema public 2>/dev/null | sed '/^A new version of Supabase CLI/,$d' > types/database.ts",
    "content:add": "tsx scripts/import-book.ts",
    "content:narrate": "tsx scripts/narrate-book.ts",
    "content:publish": "tsx scripts/publish-books.ts",
    "order:new": "tsx scripts/new-order.ts",
    "order:preview": "tsx scripts/order-preview.ts",
    "order:full-book": "tsx scripts/order-full-book.ts",
    "order:publish": "tsx scripts/order-publish.ts"
  },
  "dependencies": {
    "@supabase/server": "^1.4.0",
    "@supabase/supabase-js": "^2.53.0",
    "lucide-react": "^1.25.0",
    "next": "^15.5.20",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "dotenv": "^17.2.1",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.5.20",
    "jsdom": "^25.0.1",
    "prettier": "^3.4.2",
    "tsx": "^4.23.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
