# Little Fables — env template. Copy to .env.local and fill in.

# --- Supabase ---
# NEXT_PUBLIC_* is browser-safe. Unprefixed duplicates are for @supabase/server.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# 32+ random bytes for child-device token HMAC. `openssl rand -hex 32`
CHILD_TOKEN_SECRET=

# --- AI providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
NARRATOR_VOICE_ID=
BUDDY_VOICE_ID=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# --- Per-household daily budget ceilings (PRD D4) ---
STORY_DAILY_LIMIT=40
TTS_DAILY_LIMIT=200
ART_DAILY_LIMIT=30
RESPOND_DAILY_LIMIT=100
LISTEN_DAILY_LIMIT=100
SCORE_DAILY_LIMIT=40

# Parent gate removed by household decision (2026-07-21) — PARENT_PASSWORD is
# no longer read. Restore lib/server/parent-gate.ts from git history to re-arm.
