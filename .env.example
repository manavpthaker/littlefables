# Little Fables — env template. Copy to .env.local and fill in.
# For local dev, `pnpm db:start` uses the deterministic Supabase CLI keys.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<local supabase anon key>
SUPABASE_SERVICE_ROLE_KEY=<local supabase service role key>

# 32+ random bytes; sign child-device tokens. `openssl rand -hex 32`
CHILD_TOKEN_SECRET=

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
NARRATOR_VOICE_ID=
BUDDY_VOICE_ID=
GEMINI_API_KEY=
GOOGLE_CLOUD_PROJECT=

# Per-household daily budget ceilings (PRD D4). Guardrails fail closed above these.
STORY_DAILY_LIMIT=40
TTS_DAILY_LIMIT=200
ART_DAILY_LIMIT=30
RESPOND_DAILY_LIMIT=100
LISTEN_DAILY_LIMIT=100
SCORE_DAILY_LIMIT=40
