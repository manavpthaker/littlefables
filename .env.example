# Little Fables — env template. Copy to .env.local and fill in.

# --- Supabase ---
# NEXT_PUBLIC_* is browser-safe. Unprefixed duplicates are for @supabase/server.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# 32+ random bytes for the child-device token HMAC.
# Generate with: openssl rand -hex 32
CHILD_TOKEN_SECRET=

# --- ElevenLabs (the only runtime AI dependency) ---
# Used for live TTS on word-tap. Pre-generated page narration is uploaded
# via `pnpm content:add` and served straight from Supabase Storage.
ELEVENLABS_API_KEY=

# Voice cast. Day = normal storybook narrator. Night = sleepy bedtime voice.
DAY_VOICE_ID=
NIGHT_VOICE_ID=
# Legacy alias — read by /api/child/tts as the day-mode fallback if
# DAY_VOICE_ID is unset. Kept so pre-pare-back configs still narrate.
NARRATOR_VOICE_ID=

# ElevenLabs model override. Default is eleven_multilingual_v2 (better on
# proper nouns + non-English names than the older flash model). Opt in to
# eleven_v3 to unlock [excited]/[whispers]/[louder] emotion tags in the
# narrate CLI. v3 is ~2x cost of multilingual_v2; verify against your
# ElevenLabs dashboard before switching.
ELEVENLABS_MODEL_ID=

# --- Resend (transactional email) ---
# API key from https://resend.com. Used for OTP delivery and (later)
# gift-opened notifications. Sender must be on a domain verified in
# Resend. Configure a domain at resend.com/domains before deploying.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@littlefables.app
RESEND_FROM_NAME=Little Fables

# Where new buyer intakes ping when someone submits /intake. Defaults to
# RESEND_FROM_EMAIL if unset. Set to your personal address so the shop
# clock starts even if you're not looking at /parent/intakes.
INTAKE_NOTIFY_EMAIL=

# Absolute URL used in intake notification emails (for the admin link and
# in future for magic URLs). No trailing slash. Defaults to
# https://littlefables.app.
NEXT_PUBLIC_BASE_URL=
