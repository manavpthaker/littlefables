# Little Fables — env template. Copy to .env.local and fill in.

# --- Supabase ---
# NEXT_PUBLIC_* is browser-safe. Unprefixed duplicates are for @supabase/server.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# 32+ random bytes for the child-device token HMAC.
# Generate with: openssl rand -hex 32
CHILD_TOKEN_SECRET=

# --- ElevenLabs (the only runtime AI dependency) ---
# Used for live TTS on word-tap. Pre-generated page narration is uploaded
# via `pnpm content:add` and served straight from Supabase Storage.
ELEVENLABS_API_KEY=

# Voice cast. Day = normal storybook narrator. Night = sleepy bedtime voice.
DAY_VOICE_ID=
NIGHT_VOICE_ID=
# Legacy alias — read by /api/child/tts as the day-mode fallback if
# DAY_VOICE_ID is unset. Kept so pre-pare-back configs still narrate.
NARRATOR_VOICE_ID=

# --- Household password gate (optional) ---
# When set, any browser without a valid gate cookie is redirected to /gate
# before it can reach the reader or the settings surface. Cookie lasts
# 30 days per browser. Share links (/share/[token]) bypass this gate — a
# share carries its own auth grant.
# PARENT_PASSWORD is honored as a legacy alias.
HOUSEHOLD_PASSWORD=
