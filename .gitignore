# Supabase
supabase/.temp/
supabase/.branches/

# Generated assets — never enter git; uploaded via `pnpm content:add`
public/audio/
public/art/
content/art/candidates/
content/art/live/

# Book art + audio: image/mp3 binaries stay local. story.json,
# character-notes.md, and prompt files ARE the source of truth for a
# book and remain tracked; the heavy binary assets do not (they upload
# via `pnpm content:add` to the Supabase Storage buckets and re-fetch
# on any fresh clone via the same command).
#
# These globs said content/books/** until the tree moved to
# content/households/<household>/books/**. The rule silently stopped matching
# and forty-odd illustration PNGs became eligible to commit — nine of them
# actually did, in 9d73fef. Path changes have to be mirrored here.
content/households/**/*.png
content/households/**/*.jpg
content/households/**/*.jpeg
content/households/**/*.webp
content/households/**/*.heic
content/households/**/*.HEIC
content/households/**/*.gif
content/households/**/*.mp3

# Marketing samples are the exception: irreplaceable output of an
# image-generation session with no script to regenerate them. See the README
# in that folder.
!content/marketing/style-samples/*.png
content/households/**/*.m4a
content/households/**/*.wav
content/households/**/*.mp4
content/households/**/*.MP4
content/households/**/*.mov
content/households/**/*.docx
content/households/**/audio/
content/households/**/reference*/
content/households/**/references*/

# OS / editor
.DS_Store
.vscode/
.idea/

# Test / coverage
coverage/
.vitest-cache/

# Walkthrough film — deps, renders, and staged assets are all reproducible
video/node_modules/
video/out/
video/public/book/
video/public/recordings/
video/public/audio/
# 49MB of PNG sequences — regenerate with `npm run mark`.
video/public/mark/
# Copies of content/marketing/style-samples/ — re-copy, don't commit twice.
video/public/styles/
# Copy of assets/listing/lifestyle/ — same.
video/public/broll/
.vercel
.env*

# Art bake-off output — generated images, regenerate with `pnpm art:bakeoff`.
bakeoff-out/
content/bakeoff/style-refs/
